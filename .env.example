# Copier ce fichier en .env puis adapter les valeurs.

# MongoDB : `npm run db:up` (Docker, voir docker-compose.yml) ou MongoDB Atlas (mongodb+srv://…)
MONGODB_URI="mongodb://127.0.0.1:27017/beautyhub?directConnection=true"
# Base séparée pour les tests automatisés (vidée à chaque test)
MONGODB_URI_TEST="mongodb://127.0.0.1:27017/beautyhub_test?directConnection=true"

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Adresse publique du site, utilisée dans les liens envoyés par e-mail (mot de passe oublié, vérification).
# Obligatoire en production : sans elle, le lien est construit à partir de l'en-tête Host de la requête (falsifiable).
APP_URL="http://localhost:3000"

# Envoi réel des e-mails (mot de passe oublié, vérification, rappels…) par SMTP.
# Laisser SMTP_HOST vide : e-mails simulés, visibles par le Super Admin dans « Messages envoyés » et dans le terminal.
# Gmail : SMTP_HOST="smtp.gmail.com", SMTP_PORT=465, SMTP_USER=votre adresse Gmail,
#   SMTP_PASS = « mot de passe d'application » (compte Google > Sécurité > Validation en deux étapes > Mots de passe des applications).
# Autres fournisseurs (Brevo, Outlook, Mailtrap…) : reprendre l'hôte, le port et les identifiants SMTP qu'ils indiquent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Expéditeur affiché (par défaut : Glowy <SMTP_USER>)
MAIL_FROM=""

# Mot de passe commun des comptes de démonstration créés par `npm run db:seed`
# (client, gérante, employée, super admin — voir scripts/seed.ts)
SEED_DEMO_PASSWORD="Glowy2026!"

# Connexion démo en un clic par rôle (page de connexion). Mettre false hors démonstration.
DEMO_LOGIN=true

# Notifications Web Push (PWA). Générer une paire de clés : npx web-push generate-vapid-keys
# Laisser vide pour désactiver l'envoi push (les notifications restent visibles dans l'application).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@beautyhub.tn"

# Tâches planifiées (rappels de rendez-vous RES-07, expiration des points FID-07).
# Le serveur les lance toutes les 10 min ; SCHEDULER=off pour laisser faire un cron externe
# qui appelle GET /api/cron avec l'en-tête « Authorization: Bearer <CRON_SECRET> ».
SCHEDULER=on
CRON_SECRET=""

# Connexion avec Google (AUTH-08, bonus) : identifiants OAuth de la console Google Cloud.
# Laisser vide pour masquer le bouton. URI de redirection : <URL du site>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# IA de modération (gros mots en tounsi / arabizi / arabe / FR / EN masqués « *** », photos inappropriées refusées).
# Clé GRATUITE (compte Google, sans carte) : https://aistudio.google.com/apikey
# Laisser vide : seul le lexique local filtre le texte, les photos ne sont pas vérifiées.
GEMINI_API_KEY=""
# Modèle (facultatif) : par défaut gemini-flash-lite-latest (quota gratuit le plus large)
GEMINI_MODEL=""
